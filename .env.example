# Optional AI Provider API Keys
# The app works 100% out-of-the-box in Fallback Mode without ANY API keys!
# If provided, the app will use them in the priority order: Groq (fastest) -> Gemini -> OpenAI

# 1. Groq (Free tier available at console.groq.com - fastest inference ~300ms)
GROQ_API_KEY= 
GROQ_MODEL=openai/gpt-oss-20b

# 2. Google Gemini (Free tier available at aistudio.google.com)
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

